{
  "manifest_version": 3,
  "name": "LnwLiveSHTIK — ระบบจัดการไลฟ์สด TikTok Live อัตโนมัติ",
  "version": "4.0.0",
  "description": "ระบบควบคุมและจัดการการตลาดไลฟ์สด TikTok Live อัตโนมัติ 24/7 คัสตอมวิดีโอ ตั้งเวลาออกอากาศ ปักหมุดสินค้า และอ่านคอมเมนต์สด",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "activeTab",
    "alarms",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "http://102.129.229.177:8000/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LnwLiveSHTIK — ผู้ช่วยไลฟ์สด TikTok",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
